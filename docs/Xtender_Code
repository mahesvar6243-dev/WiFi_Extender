#include <SPI.h>
#include <RF24.h>

// -----------------------------
// VSPI - nRF24 #1
// -----------------------------
#define NRF1_CE   4
#define NRF1_CSN  5

#define VSPI_SCK  18
#define VSPI_MISO 19
#define VSPI_MOSI 23

SPIClass vspi(VSPI);
RF24 radio1(NRF1_CE, NRF1_CSN);


// -----------------------------
// HSPI - nRF24 #2
// -----------------------------
#define NRF2_CE   16
#define NRF2_CSN  15

#define HSPI_SCK  14
#define HSPI_MISO 12
#define HSPI_MOSI 13

SPIClass hspi(HSPI);
RF24 radio2(NRF2_CE, NRF2_CSN);


void setup()
{
  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("Dual nRF24L01 Test");
  Serial.println("------------------");


  // Start VSPI
  vspi.begin(
    VSPI_SCK,
    VSPI_MISO,
    VSPI_MOSI,
    NRF1_CSN
  );

  // Start HSPI
  hspi.begin(
    HSPI_SCK,
    HSPI_MISO,
    HSPI_MOSI,
    NRF2_CSN
  );


  // Initialize nRF #1
  Serial.println("Initializing nRF #1...");

  if (!radio1.begin(&vspi))
  {
    Serial.println("nRF #1 NOT detected!");
  }
  else
  {
    Serial.println("nRF #1 detected!");

    radio1.setPALevel(RF24_PA_LOW);
    radio1.setDataRate(RF24_1MBPS);
    radio1.setChannel(100);

    radio1.openWritingPipe(0xF0F0F0F0E1LL);
    radio1.openReadingPipe(1, 0xF0F0F0F0D2LL);

    radio1.stopListening();
  }


  // Initialize nRF #2
  Serial.println("Initializing nRF #2...");

  if (!radio2.begin(&hspi))
  {
    Serial.println("nRF #2 NOT detected!");
  }
  else
  {
    Serial.println("nRF #2 detected!");

    radio2.setPALevel(RF24_PA_LOW);
    radio2.setDataRate(RF24_1MBPS);
    radio2.setChannel(100);

    radio2.openWritingPipe(0xF0F0F0F0D2LL);
    radio2.openReadingPipe(1, 0xF0F0F0F0E1LL);

    radio2.stopListening();
  }

  Serial.println();
  Serial.println("Test complete.");
}


void loop()
{
  const char message[] = "Hello from ESP32";

  if (radio1.isChipConnected())
  {
    bool result1 = radio1.write(&message, sizeof(message));

    if (result1)
      Serial.println("nRF #1 transmission successful");
    else
      Serial.println("nRF #1 transmission failed");
  }


  if (radio2.isChipConnected())
  {
    bool result2 = radio2.write(&message, sizeof(message));

    if (result2)
      Serial.println("nRF #2 transmission successful");
    else
      Serial.println("nRF #2 transmission failed");
  }


  delay(1000);
}
